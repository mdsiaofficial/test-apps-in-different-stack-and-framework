{
  "name": "bun-bunjs",
  "version": "1.0.0",
  "description": "Raw Bun backend (Bun.serve + Bun.SQL, TypeScript run natively) for shared API contract",
  "type": "module",
  "module": "src/server.ts",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
